# Public site URL used for canonical links, the sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production. Any long random string.
AUTH_SECRET=replace-with-a-long-random-string

# MongoDB connection string. Leave blank to keep using the local JSON files.
MONGODB_URI=

# First administrator, created once when the database is empty of that email.
ADMIN_EMAIL=admin@isdoresolar.example
ADMIN_PASSWORD=replace-with-at-least-8-characters

# Minutes of inactivity before an open checkout is treated as abandoned.
CHECKOUT_ABANDON_MINUTES=60

# How long visitor events and checkout records are kept.
ANALYTICS_RETENTION_DAYS=180

# Where form notifications are delivered.
STORE_EMAIL=hello@isdoresolar.example
MAIL_FROM="Isdore Solar <hello@isdoresolar.example>"

# Leave SMTP blank in local development. Subscribers, quotes, and orders
# are still saved on the server. Mail sends once these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
